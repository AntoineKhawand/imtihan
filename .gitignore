# Dependencies
node_modules/
.pnp/
.pnp.js

# Testing
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Regenerated by npm run audit:seo / audit:geo — see scripts/seo-audit.mjs
# and scripts/geo-audit.mjs. Re-run rather than trust a stale committed copy.
SEO_AUDIT_REPORT.md
GEO_AUDIT_REPORT.md

# Next.js
.next/
out/
build/
dist/

# Misc
.DS_Store
*.pem
.vscode/
.idea/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files — CRITICAL: never commit secrets
.env
.env*.local
.env.production

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Firebase
.firebase/
firebase-debug.log

# Generated exams (local testing)
generated/
tmp/

# Helper scripts created during dev/automation sessions (git-push workaround
# bat files, scratch/result files) — generalized pattern so new ones from the
# daily scheduled task don't need a new .gitignore entry each time.
*.bat
*-result.txt
scan-result.txt
fix-git-lock.ps1

# Claude Code local worktrees (subagent isolation) — never commit
.claude/
