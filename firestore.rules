rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Each user can read and write their own exams
      match /exams/{examId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // School bank — any authenticated user can read; writes restricted to authenticated users
    match /schoolBank/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Student profiles — each student reads/writes their own
    match /student_profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Student attempts — students read/write only their own attempts
    match /student_attempts/{attemptId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
