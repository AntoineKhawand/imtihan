{
  "name": "imtihan",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered exam generator for Lebanese teachers — Bac Libanais, Bac Français, IB, and University",
  "allowScripts": {
    "@firebase/util@1.12.1": true,
    "canvas@3.2.3": true,
    "protobufjs@7.5.5": true,
    "re2@1.24.0": true,
    "unrs-resolver@1.11.1": true
  },
  "overrides": {
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "@fastify/busboy": "^3.2.2"
  },
  "scripts": {
    "predev": "node scripts/generate-static-routes.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/generate-static-routes.mjs",
    "build": "cross-env NEXT_TURBO_FORCE_NO_TURBOPACK=1 next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:daily": "node scripts/run-daily-phase.mjs",
    "audit:seo": "node scripts/seo-audit.mjs",
    "audit:geo": "node scripts/geo-audit.mjs",
    "generate:sitemap-routes": "node scripts/generate-static-routes.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@chemistry/formula": "^3.1.0",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@google-analytics/data": "^7.2.1",
    "@google/generative-ai": "^0.24.1",
    "@react-pdf/renderer": "^4.1.5",
    "@types/katex": "^0.16.8",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "docx": "^9.0.3",
    "dotenv": "^17.4.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.0.2",
    "framer-motion": "^11.15.0",
    "function-plot": "^1.25.4",
    "geist": "^1.7.0",
    "katex": "^0.16.45",
    "lucide-react": "^0.468.0",
    "mathjs": "^15.2.0",
    "mathml2omml": "^0.5.0",
    "next": "^16.3.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-dropzone": "^14.3.5",
    "react-markdown": "^10.1.0",
    "sonner": "^1.7.1",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.6.0",
    "temml": "^0.13.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "canvas": "^3.2.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.3",
    "firebase-tools": "^15.7.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
